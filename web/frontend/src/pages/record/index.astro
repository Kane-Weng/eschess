---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const chapters = (await getCollection("record")).sort(
  (a, b) => a.data.order - b.data.order,
);

const resolveHref = (href: string) => {
  if (href.startsWith('#')) return href;
  return `${import.meta.env.BASE_URL}${href}`;
};
---

<BaseLayout
  title="The Detailed Record — Eschess"
  description="An interactive engineering blog telling the engine's story through the six chess pieces, Pawn to King."
>
  <canvas id="blueprint-canvas" class="fixed inset-0 z-0 pointer-events-none"></canvas>

  <main class="relative z-10 mx-auto max-w-3xl px-6 pb-28">
    <nav class="pt-10 text-sm">
      <a href={resolveHref("/")} class="text-slate-500 hover:text-slate-300">&larr; Eschess</a>
    </nav>

    <header class="pt-10 pb-12">
      <p class="text-sm uppercase tracking-widest text-[var(--color-accent)]">
        The Detailed Record
      </p>
      <h1
        class="mt-3 font-[var(--font-display)] text-4xl font-bold tracking-tight sm:text-5xl"
      >
        The Six Pieces of Eschess
      </h1>
      <p class="mt-4 max-w-xl text-sm leading-relaxed text-slate-400">
        An interactive engineering blog of how Eschess is built, one chapter per piece. 
        It moves from the foundational building blocks up to the high-level orchestration,
        with live widgets embedded between the paragraphs.
      </p>
    </header>

    <ol class="flex flex-col gap-3">
      {
        chapters.map((c) => {
          const isPrologue = c.data.order === 0;
          return (
          <li>
            <a
              href={resolveHref(`/record/${c.id}`)}
              class={`group flex items-center gap-5 rounded-xl border px-6 py-5 transition-colors ${
                isPrologue
                  ? "border-amber-400/20 bg-amber-950/20 hover:border-amber-400/60"
                  : "border-white/10 bg-slate-900/60 hover:border-[var(--color-accent)]/60"
              }`}
            >
              <span
                class={`text-4xl leading-none transition-transform duration-300 group-hover:scale-110 ${
                  isPrologue ? "text-amber-400" : "text-[var(--color-accent)]"
                }`}
                aria-hidden="true"
              >
                {c.data.piece}
              </span>
              <span class="min-w-0 flex-1">
                <span class="flex flex-wrap items-center gap-3">
                  <span class="font-[var(--font-display)] text-lg font-semibold tracking-tight">
                    {isPrologue
                      ? `${c.data.pieceName} — ${c.data.title}`
                      : `${c.data.order}. ${c.data.pieceName} — ${c.data.title}`}
                  </span>
                  {isPrologue && (
                    <span class="rounded-full border border-amber-400/30 px-2 py-0.5 text-[0.6rem] uppercase tracking-wider text-amber-400/80">
                      Prologue
                    </span>
                  )}
                  {c.data.draft && (
                    <span class="rounded-full border border-white/10 px-2 py-0.5 text-[0.6rem] uppercase tracking-wider text-slate-500">
                      Draft
                    </span>
                  )}
                </span>
                <span class="mt-1 block text-sm leading-relaxed text-slate-400">
                  {c.data.summary}
                </span>
              </span>
              <span
                class="text-2xl text-slate-600 transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                &rsaquo;
              </span>
            </a>
          </li>
          );
        })
      }
    </ol>
  </main>
</BaseLayout>

<script>
  function initCanvas() {
    const canvas = document.getElementById("blueprint-canvas") as HTMLCanvasElement;
    if (!canvas) return;
    
    const ctx = canvas.getContext("2d")!;
    if (!ctx) return;

    // --- CONFIGURATION ---
    const GRID_SIZE = 24;
    const LINE_COLOR_V = "rgba(34, 211, 238, 0.04)"; 
    const LINE_COLOR_H = "rgba(34, 211, 238, 0.08)"; 

    let width = 0;
    let height = 0;
    let activeSquares: { x: number; y: number; life: number; maxLife: number }[] = [];

    function resize() {
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width;
      canvas.height = height;
    }

    window.addEventListener("resize", resize);
    resize();

    function animate() {
      ctx.clearRect(0, 0, width, height);

      if (Math.random() < 0.15) { 
        const cols = Math.ceil(width / GRID_SIZE);
        const rows = Math.ceil(height / GRID_SIZE);
        const x = Math.floor(Math.random() * cols);
        const y = Math.floor(Math.random() * rows);

        activeSquares.push({
          x,
          y,
          life: 0,
          maxLife: 100 + Math.random() * 150, 
        });
      }

      for (let i = activeSquares.length - 1; i >= 0; i--) {
        const sq = activeSquares[i];
        sq.life++;

        if (sq.life >= sq.maxLife) {
          activeSquares.splice(i, 1);
          continue;
        }

        const opacity = Math.sin((sq.life / sq.maxLife) * Math.PI) * 0.15;
        
        ctx.fillStyle = `rgba(34, 211, 238, ${opacity})`;
        ctx.fillRect(
          sq.x * GRID_SIZE,
          sq.y * GRID_SIZE,
          GRID_SIZE,
          GRID_SIZE
        );
      }

      ctx.beginPath();
      for (let x = 0; x < width; x += GRID_SIZE) {
        ctx.moveTo(x, 0);
        ctx.lineTo(x, height);
      }
      ctx.strokeStyle = LINE_COLOR_V;
      ctx.stroke();

      ctx.beginPath();
      for (let y = 0; y < height; y += GRID_SIZE) {
        ctx.moveTo(0, y);
        ctx.lineTo(width, y);
      }
      ctx.strokeStyle = LINE_COLOR_H;
      ctx.stroke();

      requestAnimationFrame(animate);
    }

    animate();
  }

  initCanvas();
  document.addEventListener('astro:page-load', initCanvas);
</script>