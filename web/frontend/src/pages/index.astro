---
import BaseLayout from "../layouts/BaseLayout.astro";
import ModuleAccordion from "../components/ModuleAccordion.svelte";
import BackgroundScene from "../components/scene/BackgroundScene.svelte";
---

<!-- Landing Page -->
<BaseLayout
  title="Eschess"
  description="A cross-language chess engine, made visible: bitboards, alpha-beta, neural networks, and an LLM coach."
>
  <!-- Cinematic auto-playing 3D chess background (non-interactive). -->
  <BackgroundScene client:only="svelte" />

  <main class="relative z-10 mx-auto flex min-h-screen max-w-3xl flex-col px-6">
    <!-- Minimal Hero -->
    <header class="flex flex-col items-center pt-28 pb-16 text-center">
      <span class="mb-6 text-6xl text-[var(--color-accent)]" aria-hidden="true">♟</span>
      <h1
        class="font-[var(--font-display)] text-6xl font-bold tracking-tight sm:text-7xl"
      >
        Eschess
      </h1>
      <p class="mt-4 text-lg text-slate-400">see how engine thinks</p>
      <p class="mt-6 max-w-xl text-balance text-sm leading-relaxed text-slate-500">
        A chess engine built across Python, C++, and Rust, from raw bitboards and
        alpha-beta search to neural networks and an LLM coach. Every part is made
        visible.
      </p>
    </header>

    <!-- Four main modules -->
    <section aria-label="Modules" class="pb-28">
      <ModuleAccordion client:load />
    </section>

    <!-- links for Portfolio & Source Code -->
    <div class="flex justify-center gap-8 pb-12">
      <a
        href="https://kane-weng.github.io/my-site/"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-2 text-sm text-slate-500 transition-colors hover:text-[var(--color-accent)]"
        aria-label="Personal Website"
      >
        <svg class="h-5 w-5 fill-current transition-transform group-hover:scale-110" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
        </svg>
        <span class="sr-only sm:not-sr-only sm:inline">My Portfolio</span>
      </a>

      <a
        href="https://github.com/Kane-Weng/eschess"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-2 text-sm text-slate-500 transition-colors hover:text-slate-300"
        aria-label="GitHub Repository"
      >
        <svg class="h-5 w-5 fill-current transition-transform group-hover:scale-110" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
        <span class="sr-only sm:not-sr-only sm:inline">Source Code</span>
      </a>
    </div>

    <footer class="mt-auto border-t border-white/5 py-8 text-center text-xs text-slate-600">
      Eschess — an engineering showcase.
    </footer>
  </main>
</BaseLayout>
