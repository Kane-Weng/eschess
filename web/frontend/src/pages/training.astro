---
import BaseLayout from "../layouts/BaseLayout.astro";
import TrainingDashboard from "../components/training/TrainingDashboard.svelte";

const resolveHref = (href: string) => {
  if (href.startsWith('#')) return href;
  return `${import.meta.env.BASE_URL}${href}`;
};
---

<BaseLayout
  title="Live Training | Eschess"
  description="A training-room dashboard streaming the AlphaZero-style self-play loop: moving-average policy and value loss, evolving win/draw/loss ratios, and the acceptance gate, live over a WebSocket."
>
  <main class="mx-auto max-w-6xl px-6 pb-24">
    <nav class="pt-10 text-sm">
      <a href={resolveHref("/")} class="text-slate-500 hover:text-slate-300">&larr; Eschess</a>
    </nav>

    <header class="border-b border-white/5 pt-8 pb-8">
      <div class="flex items-center gap-5">
        <span class="text-6xl leading-none text-[var(--color-accent)]" aria-hidden="true">♛</span>
        <div>
          <p class="text-xs uppercase tracking-widest text-slate-500">Module</p>
          <h1 class="mt-1 font-[var(--font-display)] text-3xl font-bold tracking-tight sm:text-4xl">
            Live Training &amp; Dashboard
          </h1>
          <p class="mt-1 max-w-2xl text-sm text-slate-400">
            The training room. Each generation of the AlphaZero-style loop plays
            self-play games, trains candidate networks, and gates them against the
            current best. Pick a recorded run and Replay it, or Attach to a run the
            local trainer is still writing, and watch the policy and value loss settle
            while the win/draw/loss mix shifts generation to generation.
          </p>
          <p class="mt-2 text-xs text-slate-500">
            Needs the backend on :8123 &mdash;
            <code class="text-slate-400"
              >uv run --extra web uvicorn app.main:app --port 8123 --app-dir web/backend</code
            >. Recorded runs come from <code class="text-slate-400">python -m nn.rl</code>.
          </p>
        </div>
      </div>
    </header>

    <div class="mt-8">
      <TrainingDashboard client:only="svelte" />
    </div>
  </main>
</BaseLayout>
